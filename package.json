  "description": "Your own Chrome, driven from the wings: a background tab group for any CLI agent, with per-site permission.",
  "license": "MIT",
  "author": "ghost",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
